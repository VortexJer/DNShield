<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de HTTP en claro: listas, catalogo y DoH van siempre por TLS con los certificados del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
